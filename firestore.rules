rules_version = '2';

// Chokro — Firestore security rules.
//
// Client-created document models (all other fields are server-owned):
//   users: name, email, role, status, createdAt, optional trusted profile photo
//   wallets: userId, balance=0, updatedAt
//   disposals: identity, trusted photo reference, location, declaration,
//              status=pending, flags=[], createdAt
//   claims: identity, trusted photo reference, action, optional story,
//           publication permission/snapshot, status=pending, createdAt
//   sellerApplications: identity, business text, status=pending, createdAt
//   products: the seller's own listing — text, category, tags, price, stock,
//             own-folder image URLs, active, server clock
//   carts: identity, items[] of productId and qty ONLY — never a price
//   appeals: identity, the rejected disposal or claim, the user's case,
//            status=pending, createdAt
// Every client create uses an exact key allowlist, bounded strings/numbers, a
// closed enum and the server clock. Validators below are also applied after the
// narrow client/admin updates, so an allowed field cannot be changed to an
// invalid type or unbounded value.
//
// THE ONE RULE THAT MATTERS
// -------------------------
// No client writes a balance. Not a user, not an administrator.
//
// Every field that decides or records a payout — wallet balances, ledger
// entries, disposal status, points awarded, screening results, bin geofences,
// and the points policy itself — is written by the trusted Node service using
// the Firebase Admin SDK, which bypasses these rules entirely. What follows is
// therefore not "the rules that award points"; it is the rules that make it
// impossible for anything except the server to award points.
//
// Why the admin is blocked too: if administrators could write wallets directly,
// there would be two code paths that credit a balance and rules could only
// police one of them. The admin's approve button calls the server like
// everything else. That is what makes the sentence above true without
// qualification.
//
// Corollary: read access is generous here, write access is nearly absent. That
// asymmetry is the design, not an oversight.
//
// M3 ADDS ONE COLLECTION A CLIENT REALLY WRITES
// ---------------------------------------------
// `products` is a seller's own listing, and the write means it. The test applied
// throughout this file is whether the governing constraint is expressible where
// it is enforced — for a price, "the owning seller, in good standing, within
// these bounds" is something rules can state, so it stays here. For a wallet
// balance, the governing constraint is "only after a photograph was screened",
// which they cannot, so it goes to the server.
//
// A price is still never trusted from a request: the server reads it from the
// stored document inside the checkout transaction. `orders` — where the points
// actually move — is denied to every client, administrators included.

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers (M1, unchanged)
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function uidUnchanged() {
      return !('userId' in request.resource.data)
        || (isAuthenticated()
          && request.resource.data.userId == request.auth.uid);
    }

    function uidNotModified() {
      return !('userId' in request.resource.data)
        || request.resource.data.userId == resource.data.userId;
    }

    // Existing names retained for readability throughout the established rules.
    function isSignedIn() {
      return isAuthenticated();
    }

    function isSelf(uid) {
      return isOwner(uid);
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Whether this account may act (F5.3).
    //
    // A suspension is either indefinite or timed. Nothing in this system runs
    // on a schedule — Cloud Functions need a billing card and the free Render
    // instance sleeps — so no process exists that could flip `status` back to
    // 'active' when a timed suspension runs out. The expiry is therefore
    // resolved here, at request time, exactly as lockoutActive() resolves its
    // own window further down.
    //
    // A missing `suspendedUntil` means the suspension is indefinite, so its
    // absence must never read as "expired" — hence the explicit key check
    // rather than a comparison against a null.
    //
    // Declared above isAdmin() because isAdmin() now depends on it.
    //
    // Mirrored by UserModel.isActiveAt, and proven by
    // rules_test/suspension.rules.test.js.
    function isActiveWith(u) {
      return u.status == 'active'
        || (
          u.status == 'suspended'
          && 'suspendedUntil' in u
          && u.suspendedUntil < request.time
        );
    }

    // An administrator who may currently act.
    //
    // THE STATUS CHECK IS NOT DECORATION.
    // This used to read the role alone. A suspended administrator therefore
    // kept every privilege in this file — and because the admin branch of the
    // `users` update rule below is a raw client write with no server in the
    // path, the shortest exploit was one document write: a suspended admin sets
    // `status: 'active'` on their own record and is reinstated. They could also
    // change roles, promote a confederate, resolve appeals and read every
    // wallet in the meantime. The server got this right (`requireAuth` resolves
    // the suspension through `isActiveProfile`); the rules layer did not.
    //
    // Resolved from ONE userData() read, so this costs no more than the
    // role-only version did — which matters, because rules do not cache get()
    // and the budget is ten document reads per request.
    function isAdmin() {
      return isSignedIn() && isActiveAdminWith(userData());
    }

    function isActiveAdminWith(u) {
      return u.role == 'admin' && isActiveWith(u);
    }

    function validString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // The Cloudinary account this project's images are served from.
    //
    // DEPLOYMENT COUPLING — this must equal the server's
    // `CLOUDINARY_CLOUD_NAME`. It is the one value in this file that is tied to
    // a specific Cloudinary account, and it is here, once, so that pointing a
    // deployment at a different account is a single edit. If the two disagree,
    // every listing photo write fails with permission-denied while uploads keep
    // succeeding, which is a confusing pairing — so change both together.
    //
    // A cloud name is not a secret; it appears in the path of every image URL
    // the app serves publicly.
    //
    // Kept regex-safe deliberately: the value is interpolated into `matches()`
    // patterns below, so a name containing `.` would need escaping there.
    function cloudinaryCloud() {
      return 'ata3ir5d';
    }

    function validProfilePhoto(u, uid) {
      return (
          !('profilePhotoUrl' in u)
          && !('profilePhotoPublicId' in u)
        ) || (
          'profilePhotoUrl' in u
          && 'profilePhotoPublicId' in u
          && validString(u.profilePhotoUrl, 20, 1000)
          && validString(u.profilePhotoPublicId, 20, 500)
          && u.profilePhotoUrl.matches(
               '^https://res[.]cloudinary[.]com/' + cloudinaryCloud() + '/image/upload/' +
               '(v[0-9]+/)?chokro/profiles/' + uid +
               '/[A-Za-z0-9_-]{1,200}[.][A-Za-z0-9]{2,5}$'
             )
          && u.profilePhotoPublicId.matches(
               '^chokro/profiles/' + uid + '/[A-Za-z0-9_-]{1,200}$'
             )
        );
    }

    function validUser(u, uid) {
      return u.keys().hasOnly([
          'name', 'email', 'role', 'status', 'createdAt',
          'suspendedAt', 'reinstatedAt', 'suspendedUntil',
          'profilePhotoUrl', 'profilePhotoPublicId'
        ])
        && u.keys().hasAll(['name', 'email', 'role', 'status', 'createdAt'])
        && validString(u.name, 2, 80)
        && validString(u.email, 3, 254)
        // 'producer' is accepted so a producer's document is a *valid*
        // document — otherwise every update to one fails this validator, and a
        // producer could not change their own name while an administrator could
        // not suspend them. Accepting the value here does not grant the role:
        // create forces 'buyer', and the admin update branch below refuses to
        // move a role into or out of 'producer' (EPR-1).
        && u.role in ['buyer', 'seller', 'admin', 'producer']
        && u.status in ['active', 'suspended']
        && u.createdAt is timestamp
        && (!('suspendedAt' in u) || u.suspendedAt is timestamp)
        && (!('reinstatedAt' in u) || u.reinstatedAt is timestamp)
        && (!('suspendedUntil' in u) || u.suspendedUntil is timestamp)
        && validProfilePhoto(u, uid);
    }

    function validPhotoReference(d, uid, kind) {
      return validString(d.photoUrl, 20, 1000)
        && validString(d.photoPublicId, 20, 500)
        && d.photoUrl.matches(
             '^https://res[.]cloudinary[.]com/' + cloudinaryCloud() + '/image/upload/' +
             '(v[0-9]+/)?chokro/' + kind + '/' + uid +
             '/[A-Za-z0-9_-]{1,200}[.][A-Za-z0-9]{2,5}$'
           )
        && d.photoPublicId.matches(
             '^chokro/' + kind + '/' + uid + '/[A-Za-z0-9_-]{1,200}$'
           );
    }

    function validWalletCreate(w, uid) {
      return w.keys().hasOnly(['userId', 'balance', 'updatedAt'])
        && w.keys().hasAll(['userId', 'balance', 'updatedAt'])
        && w.userId == uid
        && w.balance is int
        && w.balance == 0
        && w.updatedAt == request.time;
    }

    function validDisposalCreate(d, uid) {
      return d.keys().hasOnly([
          'userId', 'binId', 'photoUrl', 'photoPublicId',
          'capturedLat', 'capturedLng', 'distanceMeters',
          'declaredItemCount', 'itemType', 'status', 'flags', 'createdAt'
        ])
        && d.keys().hasAll([
          'userId', 'binId', 'photoUrl', 'photoPublicId',
          'capturedLat', 'capturedLng', 'distanceMeters',
          'declaredItemCount', 'itemType', 'status', 'flags', 'createdAt'
        ])
        && uidUnchanged()
        && validString(d.binId, 1, 128)
        && validPhotoReference(d, uid, 'disposals')
        && d.capturedLat is number
        && d.capturedLat >= -90 && d.capturedLat <= 90
        && d.capturedLng is number
        && d.capturedLng >= -180 && d.capturedLng <= 180
        && !(d.capturedLat == 0 && d.capturedLng == 0)
        && d.distanceMeters is number
        && d.distanceMeters >= 0 && d.distanceMeters <= 20000000
        && d.declaredItemCount is int
        && d.declaredItemCount >= 1 && d.declaredItemCount <= 100
        && d.itemType in [
          'plasticBottle', 'plasticOther', 'paper', 'glass',
          'metal', 'eWaste', 'organic'
        ]
        && d.status == 'pending'
        && d.flags is list && d.flags.size() == 0
        && d.createdAt == request.time;
    }

    function validClaimCreate(c, uid) {
      return c.keys().hasOnly([
          'userId', 'actionType', 'photoUrl', 'photoPublicId',
          'story', 'publicationMode', 'championName', 'championPhotoUrl',
          'status', 'createdAt'
        ])
        && c.keys().hasAll([
          'userId', 'actionType', 'photoUrl', 'photoPublicId',
          'status', 'createdAt'
        ])
        && uidUnchanged()
        && c.actionType in [
          'treePlanting', 'composting', 'refusingSingleUsePlastic',
          'reusableBagOrBottle', 'communityCleanup'
        ]
        && validPhotoReference(c, uid, 'claims')
        && (!('story' in c)
          || (validString(c.story, 1, 800) && c.story == c.story.trim()))
        && (!('publicationMode' in c)
          // Kept rollout-compatible with installed older clients. The app
          // interprets absence as NO publication permission, never anonymous
          // consent, so an approved legacy claim cannot become a photocard.
          || c.publicationMode in ['anonymous', 'named'])
        && (
          (
            'publicationMode' in c
            && c.publicationMode == 'named'
            && c.keys().hasAll(['championName', 'championPhotoUrl'])
            && validString(c.championName, 2, 80)
            && validString(c.championPhotoUrl, 20, 1000)
            && c.championName == userData().name
            && 'profilePhotoUrl' in userData()
            && c.championPhotoUrl == userData().profilePhotoUrl
          ) || (
            (!('publicationMode' in c) || c.publicationMode == 'anonymous')
            && !('championName' in c)
            && !('championPhotoUrl' in c)
          )
        )
        && c.status == 'pending'
        && c.createdAt == request.time;
    }

    function validSellerApplication(a) {
      return a.keys().hasOnly([
          'userId', 'businessName', 'description', 'status', 'createdAt',
          'reviewedBy', 'reviewedAt', 'reason'
        ])
        && a.keys().hasAll([
          'userId', 'businessName', 'description', 'status', 'createdAt'
        ])
        && validString(a.userId, 1, 128)
        && validString(a.businessName, 2, 120)
        && validString(a.description, 20, 1000)
        && a.status in ['pending', 'approved', 'rejected']
        && a.createdAt is timestamp
        && (!('reviewedBy' in a) || validString(a.reviewedBy, 1, 128))
        && (!('reviewedAt' in a) || a.reviewedAt is timestamp)
        && (!('reason' in a) || validString(a.reason, 1, 500))
        && (a.status != 'rejected'
          || ('reason' in a && validString(a.reason, 10, 500)));
    }

    // Reads the user document exactly once.
    //
    // Firestore does not cache get() across calls within one rule evaluation,
    // and each counts against a hard per-request budget of 10 document reads.
    // The previous form called userData() four times, which pushed the disposal
    // create path over the limit and surfaced as an evaluation error rather
    // than a clean denial.
    function isActive() {
      return isSignedIn() && isActiveWith(userData());
    }

    // -------------------------------------------------------------------------
    // Helpers (M2)
    // -------------------------------------------------------------------------

    // A bin that exists and is currently accepting submissions.
    function binIsOpen(binId) {
      return exists(/databases/$(database)/documents/bins/$(binId))
        && get(/databases/$(database)/documents/bins/$(binId)).data.active == true;
    }

    // Whether this user is inside the lockout window for this bin (§7.3, F2.6).
    //
    // Rules cannot run a time-window query across a collection, which is why the
    // lockout is a single document keyed {userId}_{binId} whose expiry can be
    // read in one lookup. Absent document or past expiry means free to submit.
    function lockoutActive(uid, binId) {
      return exists(/databases/$(database)/documents/lockouts/$(uid + '_' + binId))
        && get(/databases/$(database)/documents/lockouts/$(uid + '_' + binId)).data.expiresAt > request.time;
    }

    // -------------------------------------------------------------------------
    // Helpers (EPR producer portal) — tenant isolation
    // -------------------------------------------------------------------------
    //
    // SEC-1 is the primary control in this feature, and its failure mode is the
    // most damaging incident this product can have: one company reading
    // another's compliance position. Everything below exists to make that a
    // single, unforgeable document read.
    //
    // WHY MEMBERSHIP IS A DOCUMENT AND NOT A CLAIM
    // A custom claim is a cache, not the authority (SEC-2). It is only as fresh
    // as the client's last token refresh, so a member removed this morning
    // keeps a valid token carrying `orgOwner` until it expires. These rules
    // therefore never read `request.auth.token.orgId` or `orgRole`, and the
    // server re-reads the same stored document on every write. A removal takes
    // effect on the next request, everywhere, which is what "revoked" has to
    // mean for a corporate dataset.
    //
    // WHY THE COMPOSITE ID
    // `organizationMembers/{orgId}_{uid}` lets these rules *compose* the path
    // they check from the resource being accessed and the authenticated uid —
    // no query, no index, and nothing believed on the client's word. A
    // membership that had to be found by query would mean trusting something in
    // the request to build that query, which is the hole this shape closes.
    // `lockoutActive` above uses the same trick for the same reason.

    function orgMemberPath(orgId) {
      return /databases/$(database)/documents/organizationMembers/$(orgId + '_' + request.auth.uid);
    }

    function orgMemberData(orgId) {
      return get(orgMemberPath(orgId)).data;
    }

    // Whether a membership document carries at least `minRole`.
    //
    // Mirrors `OrgRoles.atLeast` in Dart and `requireOrgRole` on the server; all
    // three must agree. Fails closed on both halves: a membership that is not
    // `active` holds nothing (an invitation is not a membership), and an
    // orgRole this rule set does not recognise matches none of the lists below.
    function orgRoleAtLeast(m, minRole) {
      return m.status == 'active'
        && (minRole == 'orgViewer'
              ? m.orgRole in ['orgOwner', 'orgReporter', 'orgViewer']
              : (minRole == 'orgReporter'
                  ? m.orgRole in ['orgOwner', 'orgReporter']
                  : m.orgRole == 'orgOwner'));
    }

    // Three document reads: the user, the membership's existence, the
    // membership itself. Rules do not cache get(), and the budget is ten, so
    // this is deliberately the whole cost of an authorisation decision here.
    //
    // `isActive()` is not decoration. A suspended platform account keeps its
    // stored membership document — suspension does not rewrite other
    // collections — so without it a suspended employee would keep full read
    // access to the company's compliance data.
    function isOrgMemberAtLeast(orgId, minRole) {
      return isSignedIn()
        && isActive()
        && exists(orgMemberPath(orgId))
        && orgRoleAtLeast(orgMemberData(orgId), minRole);
    }

    function isOrgMember(orgId) {
      return isOrgMemberAtLeast(orgId, 'orgViewer');
    }

    // The disjoint producer role (EPR-1).
    //
    // Mirrors `UserModel.isProducer` in Dart. It grants nothing: authorisation
    // inside the portal comes from membership, never from the platform role
    // alone. A producer with no active membership can do nothing, which is
    // correct — the role says which workspace exists, the membership says
    // whose.
    //
    // What it does is keep producers *out* of the citizen surfaces, which is
    // the half of disjointness the rules have to enforce. `isActive()` is true
    // for a producer account — it is a perfectly ordinary active account — so
    // every client create path gated only on activity would accept one. A
    // corporate compliance account submitting disposals for the brand whose
    // collected kilograms Chokro certifies is the exact conflict EPR-1 exists
    // to prevent, and `isActiveCitizen()` below is where that is refused.
    function isProducerWith(u) {
      return u.role == 'producer';
    }

    // An active account that belongs to the citizen hierarchy.
    //
    // Written as a `*With(u)` pair for the same budget reason as
    // `isActiveSellerWith` further down: rules do not cache get(), and calling
    // `isActive()` and a separate producer check would spend two of the
    // ten-read allowance on one user document.
    function isActiveCitizenWith(u) {
      return isActiveWith(u) && !isProducerWith(u);
    }

    function isActiveCitizen() {
      return isSignedIn() && isActiveCitizenWith(userData());
    }

    // -------------------------------------------------------------------------
    // users (M1, unchanged)
    // -------------------------------------------------------------------------

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && validUser(request.resource.data, uid)
        // Firebase Auth is the authority for the account address. Without this
        // equality check a newly registered user could store somebody else's
        // email in their private profile, corrupting identity and audit data.
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'buyer'
        && request.resource.data.status == 'active'
        && !('profilePhotoUrl' in request.resource.data)
        && !('profilePhotoPublicId' in request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if (isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && validUser(request.resource.data, uid))
        || (isAdmin()
          // An administrator may not edit their OWN role or status.
          //
          // Without this, the admin branch is a self-service reinstatement:
          // suspend an administrator and they write `status: 'active'` back to
          // their own document. It also stops a compromised admin session
          // entrenching itself, and it costs nothing legitimate — the accounts
          // screen already refuses to suspend the signed-in account, so this
          // makes the rule agree with the interface.
          //
          // The first administrator is still promoted by hand in the Firestore
          // console, which bypasses rules entirely.
          && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'status', 'suspendedAt', 'reinstatedAt', 'suspendedUntil'])
          // The producer role is neither granted nor removed here (EPR-1,
          // EPR-4). Both directions are refused, and both for the same reason:
          // becoming a producer means redeeming an invitation and gaining a
          // membership document, and ceasing to be one means those memberships
          // are deactivated. Neither is a single field flip, so neither belongs
          // on a path where a client writes one field. The server owns both,
          // and it owns them transactionally.
          //
          // An equality rather than two comparisons, so an administrator may
          // still suspend or reinstate an existing producer account — which is
          // the platform-level control EPR-47 leans on.
          && (request.resource.data.role == 'producer')
               == (resource.data.role == 'producer')
          && validUser(request.resource.data, uid));

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // users/{uid}/devices/{token} — push registrations (F7.1)
    // -------------------------------------------------------------------------
    //
    // A subcollection rather than an `fcmTokens` array on the user document, and
    // that is a security choice before it is a modelling one. The `users` update
    // rule above permits a diff of exactly `['name']`, which is what stops a user
    // writing their own `role`. Its value comes from being one key long, so
    // adding a second permitted key to park a push token there would be a poor
    // trade. Under `rules_version = '2'` a `match /users/{uid}` does not cover
    // subcollections, so this block is purely additive and the rule above is
    // untouched.
    //
    // The token is the document ID, which makes registration idempotent: app
    // start and `onTokenRefresh` both write, and the same token lands on the same
    // document instead of accumulating a duplicate per launch.
    //
    // Read access is deliberately NARROWER than everywhere else in this file. An
    // administrator can read any user document and any submission, but not this:
    // a push token is a capability, and no admin workflow needs to enumerate
    // somebody's devices. The server prunes dead tokens through the Admin SDK,
    // which bypasses these rules, so no client path is needed for that either.
    //
    // Not gated on isActive(). A suspended user is precisely the person owed a
    // notification — the message explaining why a submission was rejected is the
    // one they need most, and the appeal path (F5.4) depends on them knowing a
    // decision happened at all. `devices.rules.test.js` names that case
    // explicitly so the reflexive reading of "suspended" cannot creep back in.
    match /users/{uid}/devices/{token} {
      allow read, delete: if isSelf(uid);

      // `hasOnly` + `hasAll` pins the shape to exactly these two keys. There is
      // no server-owned field here today; this is what stops one appearing under
      // a user's control tomorrow. It also means a debugging extra like a device
      // name fails with permission-denied — the same trap already documented on
      // `UserService.updateName`.
      //
      // `updatedAt` must be the server's clock, like every other timestamp in
      // this file. A phone set to 2030 would otherwise sort itself to the top of
      // the device list forever and crowd out the user's real devices, since the
      // server notifies the ten most recently seen.
      allow create, update: if isSelf(uid)
        && token.size() <= 512
        && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
        && request.resource.data.keys().hasAll(['platform', 'updatedAt'])
        && request.resource.data.platform in ['android', 'ios', 'web']
        && request.resource.data.updatedAt == request.time;
    }

    // -------------------------------------------------------------------------
    // wallets — read your own, never write one
    // -------------------------------------------------------------------------

    match /wallets/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // Creation stays client-side and stays pinned to zero.
      //
      // This is the one client write to a wallet document, and it is deliberate:
      // registration opens the user document and the wallet atomically in a
      // single batch (§6 invariant, and a hard-won lesson from the sibling
      // project). A wallet that can only ever be born holding zero cannot be
      // used to steal anything, so allowing it costs nothing and keeps signup
      // independent of the server being reachable.
      allow create: if isSelf(uid)
        && validWalletCreate(request.resource.data, uid);

      // Every subsequent balance change belongs to the Admin SDK. An admin is
      // refused here exactly as a buyer is.
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // transactions — the ledger. Append-only, and only by the server.
    // -------------------------------------------------------------------------

    match /transactions/{txId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      // NFR-4: every balance change is a ledger entry, and balance is
      // reconstructable from history. Both properties die the moment a client
      // can write, amend or remove an entry.
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // bins — read to scan, server to register
    // -------------------------------------------------------------------------

    match /bins/{binId} {
      // Any signed-in user may resolve a scanned code. Inactive bins are
      // readable too so the app can say "this bin is no longer in service"
      // rather than failing as if the code were fake.
      allow read: if isSignedIn();

      // Written by the server, including for administrators. A bin's
      // coordinates and radius are inputs the server trusts when deciding a
      // payout, so they sit on the server side of the boundary with everything
      // else the server trusts.
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // disposals — the client may submit, and may do nothing else
    // -------------------------------------------------------------------------

    match /disposals/{disposalId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      // isActiveCitizen(), not isActive(): a producer account is active, and
      // must not be able to submit the disposals that produce its own
      // attributed kilograms (EPR-1).
      allow create: if isSignedIn()
        && isActiveCitizen()
        && validDisposalCreate(request.resource.data, request.auth.uid)

        && binIsOpen(request.resource.data.binId)
        && !lockoutActive(request.auth.uid, request.resource.data.binId);

      // Screening, approval, rejection and the points award are all server
      // writes. There is no client transition out of pending.
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // claims — the weakest earn route, and shaped accordingly (F6.1-F6.4)
    // -------------------------------------------------------------------------
    //
    // Structurally identical to `disposals`: the client may create one pending
    // record and may do nothing else. What is missing is the geofence and the
    // lockout, because a self-reported action has nothing objective to check
    // against — no bin, no radius, no distance.
    //
    // The safeguards that remain are the closed action vocabulary enforced
    // below, the weekly quota in `claimQuotas` (server-written, so a client
    // cannot lift its own limit), an administrator's own eyes, and an award
    // that §7.3 validates as strictly lower than a disposal's.
    //
    // There is no auto-approval path here at all. Every decision is a person's.

    match /claims/{claimId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && isActiveCitizen()
        && validClaimCreate(request.resource.data, request.auth.uid);

      // Approval is a payout decision, so it goes to the server like every
      // other one. This denies an administrator too — proven by the test named
      // exactly that in rules_test/claims.rules.test.js.
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // lockouts and claimQuotas — visible to the user, written by the server
    // -------------------------------------------------------------------------

    match /lockouts/{lockoutId} {
      // Readable so the app can say "you can submit at this bin again in 4h"
      // instead of letting the user photograph a bag for nothing.
      allow read: if isSignedIn()
        && (lockoutId.matches('^' + request.auth.uid + '_.*$') || isAdmin());
      allow create, update, delete: if false;
    }

    match /claimQuotas/{quotaId} {
      allow read: if isSignedIn()
        && (quotaId.matches('^' + request.auth.uid + '_.*$') || isAdmin());
      allow create, update, delete: if false;
    }

    // The daily disposal cap's counter (§7.3, F2.6).
    //
    // Keyed {userId}_{yyyy-mm-dd} and incremented by the server inside the same
    // transaction that credits an approval, exactly as claimQuotas is. It
    // replaced a query over `disposals` that counted submissions *created* today
    // rather than approvals *performed* today — which a client could sidestep by
    // deferring verification to the next day. See the note in `award.js`.
    //
    // Readable so the app can tell a user they have reached today's limit;
    // writable by nothing, because a client that could edit its own counter
    // would have no cap at all.
    match /dailyCaps/{capId} {
      allow read: if isSignedIn()
        && (capId.matches('^' + request.auth.uid + '_.*$') || isAdmin());
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // config — the points policy
    // -------------------------------------------------------------------------

    match /config/{docId} {
      // Every client reads the policy: the checkout screen needs the redemption
      // rate, the submission screen needs the disposal award to show what is
      // pending. None of it is secret.
      allow read: if isSignedIn();

      // Written by the server after PointsPolicy.validate() passes. Rules cannot
      // express the invariant that matters here — that the claim award stays
      // below the disposal award, so the weaker verification route keeps paying
      // less — so the write goes where that check can actually run.
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // sellerApplications (M1, unchanged)
    // -------------------------------------------------------------------------

    match /sellerApplications/{appId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      // A producer company does not apply to become a Greenpreneur. The role
      // is disjoint, so the application would be granting a citizen profile to
      // a corporate account (EPR-1).
      allow create: if isSignedIn()
        && isActiveCitizen()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
             'userId', 'businessName', 'description', 'status', 'createdAt'
           ])
        && validSellerApplication(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && uidNotModified()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reason'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && validSellerApplication(request.resource.data);

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Helpers (M3 — marketplace)
    // -------------------------------------------------------------------------

    // A seller in good standing, resolved from ONE user document read.
    //
    // Written as a `*With(u)` pair for the same budget reason as isActive():
    // rules do not cache get() across calls and each one spends part of a hard
    // ten-read allowance per request. Calling isActive() and a separate isSeller()
    // would read `users/{uid}` twice for every product write.
    //
    // An administrator counts as a seller here, matching UserModel.isSeller — it
    // is what lets one account demonstrate both sides of the marketplace.
    function isActiveSellerWith(u) {
      return isActiveWith(u) && u.role in ['seller', 'admin'];
    }

    function isActiveSeller() {
      return isSignedIn() && isActiveSellerWith(userData());
    }

    // One product image, checked exactly as a disposal photograph is.
    //
    // Same provenance argument as validPhotoReference: the URL must name the
    // authenticated seller's own upload folder in this project's own Cloudinary
    // account, so a listing cannot point every buyer's device at an arbitrary
    // third-party URL — nor at another seller's images.
    //
    // The account segment is pinned via `cloudinaryCloud()`, and that is
    // load-bearing here in a way it is not for evidence photographs. A product
    // document is written by the *client* (`ProductService.create`), and the
    // server never re-checks its `imageUrls` — unlike a disposal or claim
    // photograph, which `isTrustedImageReference` re-validates server-side
    // during verification. So these rules are the only check there is.
    //
    // Until the account was pinned, this pattern's cloud segment was `[^/]+`,
    // which accepted any Cloudinary account on the internet. A seller could
    // upload to a free account of their own under the folder
    // `chokro/products/<their own uid>/`, publish it, and thereafter control the
    // bytes every buyer's device fetched — swapping the image after it had been
    // seen, and collecting the viewers' addresses. Both are closed by naming the
    // one account whose contents this project actually controls.
    function validProductImage(url, uid) {
      return url is string
        && url.size() >= 20 && url.size() <= 1000
        && url.matches(
             '^https://res[.]cloudinary[.]com/' + cloudinaryCloud() + '/image/upload/' +
             '(v[0-9]+/)?chokro/products/' + uid +
             '/[A-Za-z0-9_-]{1,200}[.][A-Za-z0-9]{2,5}$'
           );
    }

    // Rules cannot iterate a list, so each slot is checked by index.
    //
    // This is why ProductLimits.maxImages is three and not "a few": the bound
    // exists so that every entry can be named explicitly. An unbounded list would
    // mean unvalidated entries, and an unvalidated entry is exactly the hole the
    // provenance check above is here to close.
    function validProductImages(p, uid) {
      return p.imageUrls is list
        && p.imageUrls.size() <= 3
        && (p.imageUrls.size() < 1 || validProductImage(p.imageUrls[0], uid))
        && (p.imageUrls.size() < 2 || validProductImage(p.imageUrls[1], uid))
        && (p.imageUrls.size() < 3 || validProductImage(p.imageUrls[2], uid));
    }

    function validSearchToken(value) {
      return validString(value, 2, 40)
        && value.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    function validTag(value) {
      return validString(value, 1, 40)
        && value.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    // Rules cannot iterate arrays. Every bounded slot is therefore named so a
    // malformed value cannot hide at the end of an otherwise valid index.
    function validProductSearchTokens(p) {
      return p.searchTokens is list
        && p.searchTokens.size() >= 1 && p.searchTokens.size() <= 30
        && (p.searchTokens.size() < 1 || validSearchToken(p.searchTokens[0]))
        && (p.searchTokens.size() < 2 || validSearchToken(p.searchTokens[1]))
        && (p.searchTokens.size() < 3 || validSearchToken(p.searchTokens[2]))
        && (p.searchTokens.size() < 4 || validSearchToken(p.searchTokens[3]))
        && (p.searchTokens.size() < 5 || validSearchToken(p.searchTokens[4]))
        && (p.searchTokens.size() < 6 || validSearchToken(p.searchTokens[5]))
        && (p.searchTokens.size() < 7 || validSearchToken(p.searchTokens[6]))
        && (p.searchTokens.size() < 8 || validSearchToken(p.searchTokens[7]))
        && (p.searchTokens.size() < 9 || validSearchToken(p.searchTokens[8]))
        && (p.searchTokens.size() < 10 || validSearchToken(p.searchTokens[9]))
        && (p.searchTokens.size() < 11 || validSearchToken(p.searchTokens[10]))
        && (p.searchTokens.size() < 12 || validSearchToken(p.searchTokens[11]))
        && (p.searchTokens.size() < 13 || validSearchToken(p.searchTokens[12]))
        && (p.searchTokens.size() < 14 || validSearchToken(p.searchTokens[13]))
        && (p.searchTokens.size() < 15 || validSearchToken(p.searchTokens[14]))
        && (p.searchTokens.size() < 16 || validSearchToken(p.searchTokens[15]))
        && (p.searchTokens.size() < 17 || validSearchToken(p.searchTokens[16]))
        && (p.searchTokens.size() < 18 || validSearchToken(p.searchTokens[17]))
        && (p.searchTokens.size() < 19 || validSearchToken(p.searchTokens[18]))
        && (p.searchTokens.size() < 20 || validSearchToken(p.searchTokens[19]))
        && (p.searchTokens.size() < 21 || validSearchToken(p.searchTokens[20]))
        && (p.searchTokens.size() < 22 || validSearchToken(p.searchTokens[21]))
        && (p.searchTokens.size() < 23 || validSearchToken(p.searchTokens[22]))
        && (p.searchTokens.size() < 24 || validSearchToken(p.searchTokens[23]))
        && (p.searchTokens.size() < 25 || validSearchToken(p.searchTokens[24]))
        && (p.searchTokens.size() < 26 || validSearchToken(p.searchTokens[25]))
        && (p.searchTokens.size() < 27 || validSearchToken(p.searchTokens[26]))
        && (p.searchTokens.size() < 28 || validSearchToken(p.searchTokens[27]))
        && (p.searchTokens.size() < 29 || validSearchToken(p.searchTokens[28]))
        && (p.searchTokens.size() < 30 || validSearchToken(p.searchTokens[29]));
    }

    function validProductTags(p) {
      return p.tags is list
        && p.tags.size() <= 8
        && (p.tags.size() < 1 || validTag(p.tags[0]))
        && (p.tags.size() < 2 || validTag(p.tags[1]))
        && (p.tags.size() < 3 || validTag(p.tags[2]))
        && (p.tags.size() < 4 || validTag(p.tags[3]))
        && (p.tags.size() < 5 || validTag(p.tags[4]))
        && (p.tags.size() < 6 || validTag(p.tags[5]))
        && (p.tags.size() < 7 || validTag(p.tags[6]))
        && (p.tags.size() < 8 || validTag(p.tags[7]));
    }

    // A listing, in the exact shape lib/models/product_model.dart writes.
    //
    // `hiddenBySuspension` is in the hasOnly list but not in hasAll: the server
    // adds it when a suspension sweeps a seller's listings out of the catalogue,
    // and a later seller edit carries it back in request.resource.data. Excluding
    // it from hasOnly would make every edit after a suspension fail; the update
    // rule below is what stops a seller *changing* it, by pinning the affected
    // key set instead.
    function validProduct(p, uid) {
      return p.keys().hasOnly([
          'sellerId', 'shopName', 'title', 'titleLower', 'searchTokens',
          'description', 'category', 'tags', 'price', 'stock', 'imageUrls',
          'active', 'createdAt', 'updatedAt', 'hiddenBySuspension'
        ])
        && p.keys().hasAll([
          'sellerId', 'shopName', 'title', 'titleLower', 'searchTokens',
          'description', 'category', 'tags', 'price', 'stock', 'imageUrls',
          'active', 'createdAt', 'updatedAt'
        ])
        && p.sellerId == uid
        && validString(p.shopName, 2, 80)
        && validString(p.title, 2, 120)
        // The index must describe the title buyers actually see. Without this a
        // seller could sell one thing and be found under the name of another.
        && p.titleLower == p.title.trim().lower()
        && validProductSearchTokens(p)
        && validString(p.description, 10, 2000)
        && p.category in [
          'homeAndLiving', 'personalCare', 'foodAndDrink', 'fashion',
          'stationery', 'gardening', 'electronics', 'other'
        ]
        && validProductTags(p)
        // Whole taka. The points economy is integer arithmetic end to end (§7.3),
        // so a fractional price would produce a discount that does not reconcile
        // against the ledger.
        && p.price is int && p.price >= 1 && p.price <= 1000000
        && p.stock is int && p.stock >= 0 && p.stock <= 100000
        && validProductImages(p, uid)
        && p.active is bool
        && p.createdAt is timestamp
        && p.updatedAt is timestamp
        && (!('hiddenBySuspension' in p) || p.hiddenBySuspension is bool);
    }

    function validAppeal(a) {
      return a.keys().hasOnly([
          'userId', 'subjectType', 'subjectId', 'message', 'status',
          'createdAt', 'response', 'reviewedBy', 'reviewedAt'
        ])
        && a.keys().hasAll([
          'userId', 'subjectType', 'subjectId', 'message', 'status', 'createdAt'
        ])
        && validString(a.userId, 1, 128)
        && a.subjectType in ['disposal', 'claim']
        && validString(a.subjectId, 1, 128)
        && validString(a.message, 20, 1000)
        && a.status in ['pending', 'upheld', 'declined']
        && a.createdAt is timestamp
        && (!('response' in a) || validString(a.response, 10, 1000))
        && (!('reviewedBy' in a) || validString(a.reviewedBy, 1, 128))
        && (!('reviewedAt' in a) || a.reviewedAt is timestamp);
    }

    function validCartItem(item) {
      return item is map
        && item.keys().hasOnly(['productId', 'qty'])
        && item.keys().hasAll(['productId', 'qty'])
        && validString(item.productId, 1, 128)
        && item.qty is int && item.qty >= 1 && item.qty <= 20;
    }

    function validCartItems(c) {
      return c.items is list
        && c.items.size() <= 20
        && (c.items.size() < 1 || validCartItem(c.items[0]))
        && (c.items.size() < 2 || validCartItem(c.items[1]))
        && (c.items.size() < 3 || validCartItem(c.items[2]))
        && (c.items.size() < 4 || validCartItem(c.items[3]))
        && (c.items.size() < 5 || validCartItem(c.items[4]))
        && (c.items.size() < 6 || validCartItem(c.items[5]))
        && (c.items.size() < 7 || validCartItem(c.items[6]))
        && (c.items.size() < 8 || validCartItem(c.items[7]))
        && (c.items.size() < 9 || validCartItem(c.items[8]))
        && (c.items.size() < 10 || validCartItem(c.items[9]))
        && (c.items.size() < 11 || validCartItem(c.items[10]))
        && (c.items.size() < 12 || validCartItem(c.items[11]))
        && (c.items.size() < 13 || validCartItem(c.items[12]))
        && (c.items.size() < 14 || validCartItem(c.items[13]))
        && (c.items.size() < 15 || validCartItem(c.items[14]))
        && (c.items.size() < 16 || validCartItem(c.items[15]))
        && (c.items.size() < 17 || validCartItem(c.items[16]))
        && (c.items.size() < 18 || validCartItem(c.items[17]))
        && (c.items.size() < 19 || validCartItem(c.items[18]))
        && (c.items.size() < 20 || validCartItem(c.items[19]));
    }

    // Whether this user owns a disposal that was actually rejected.
    //
    // An appeal is a reply to a rejection (F5.4), so the rejection has to exist
    // and has to be theirs. Without this, `appeals` would be an unmoderated text
    // collection any signed-in account could write into against any id at all.
    function ownsRejectedDisposal(uid, id) {
      return exists(/databases/$(database)/documents/disposals/$(id))
        && get(/databases/$(database)/documents/disposals/$(id)).data.userId == uid
        && get(/databases/$(database)/documents/disposals/$(id)).data.status == 'rejected';
    }

    function ownsRejectedClaim(uid, id) {
      return exists(/databases/$(database)/documents/claims/$(id))
        && get(/databases/$(database)/documents/claims/$(id)).data.userId == uid
        && get(/databases/$(database)/documents/claims/$(id)).data.status == 'rejected';
    }

    // -------------------------------------------------------------------------
    // products — the seller writes their own listing, and only their own (F4.1)
    // -------------------------------------------------------------------------
    //
    // This is one of the few collections where a client write is the real thing
    // rather than a request. That is deliberate, and it follows the same test
    // applied everywhere in this file: is the constraint expressible where it is
    // enforced? A price is the seller's own number, and "the owning seller, in
    // good standing, holding the seller role, within these bounds" is a rule
    // rules can state. Compare a wallet balance, whose governing condition is
    // "only after a photograph was screened" — which they cannot.
    //
    // Nothing here is read by the award path. `price` is the one number that
    // reaches the ledger, and the server reads it from the stored document at
    // checkout, never from the buyer's request.

    match /products/{productId} {
      // Any signed-in user may browse. The catalogue query filters on `active`;
      // a delisted product is not secret, and letting a past buyer still resolve
      // one keeps an old receipt's link from dying.
      allow read: if isSignedIn();

      allow create: if isActiveSeller()
        && validProduct(request.resource.data, request.auth.uid)
        // Server-owned from the first write. A listing cannot be born already
        // claiming it was hidden by a suspension.
        && !('hiddenBySuspension' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isActiveSeller()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'shopName', 'title', 'titleLower', 'searchTokens', 'description',
             'category', 'tags', 'price', 'stock', 'imageUrls', 'active',
             'updatedAt'
           ])
        && validProduct(request.resource.data, request.auth.uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      // Never hard-deleted (§6.2). F4.1's "delete" is `active: false`, because an
      // order line keeps a productId alongside its price snapshot and a dangling
      // reference breaks a buyer's receipt.
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // carts — the buyer's own scratchpad (F4.3)
    // -------------------------------------------------------------------------
    //
    // A cart holds product ids and quantities and NEVER a price (§6.2). That one
    // invariant is protected twice: rules validate every bounded element before
    // it is stored, and the server validates again before checkout arithmetic.
    //
    // Had a price been cached here, none of that would hold: a stale figure would
    // be a quotation the buyer could hold the seller to, and rules cannot compare
    // it against the product document.

    match /carts/{uid} {
      // Owner only, and no administrator exception. Nothing in an admin workflow
      // needs to read what somebody has not bought yet.
      allow read: if isSelf(uid);

      // No wallet, no marketplace, no cart (EPR-1).
      allow create, update: if isSelf(uid)
        && isActiveCitizen()
        && request.resource.data.keys().hasOnly(['userId', 'items', 'updatedAt'])
        && request.resource.data.keys().hasAll(['userId', 'items', 'updatedAt'])
        && request.resource.data.userId == uid
        && validCartItems(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isSelf(uid);
    }

    // -------------------------------------------------------------------------
    // orders — created and advanced by the server, read by the two parties
    // -------------------------------------------------------------------------
    //
    // §6.3 assigns the transitions by party: the seller ships and delivers, the
    // buyer confirms. Rules could express that much. They cannot express the part
    // that matters — `confirmed` is the transition that credits a wallet (F4.7),
    // so a rule letting a buyer set it would be a rule letting a client trigger a
    // payout.
    //
    // Splitting the machine, with two transitions here and one on the server,
    // would put one invariant in two places with different reasoning behind each.
    // Every transition therefore goes to the server, which checks the party, the
    // state order and the idempotence in one function — and this collection is
    // denied to every client, administrators included, exactly like `disposals`.
    //
    // Read access covers both counterparties: a cash-on-delivery transaction that
    // only one side can see is not a transaction either can act on.

    match /orders/{orderId} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
          || isAdmin());

      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // appeals — a user answers a rejection, an administrator answers back (F5.4)
    // -------------------------------------------------------------------------
    //
    // Shaped exactly like `sellerApplications`, and for the same reason: resolving
    // an appeal moves no points, so the whole decision is expressible in rules and
    // belongs here rather than on the server.
    //
    // That an appeal cannot pay out is a design decision, not a gap. A rejection
    // releases the bin lockout so a legitimate submission can be made again — the
    // remedy for a wrong rejection is a fresh submission through the full
    // verification pipeline, not a hand-credited award that skips it.

    match /appeals/{appealId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        // One appeal per user and rejected subject. A deterministic id turns a
        // second create into an update, which the appellant is not allowed to
        // perform, instead of allowing an unlimited duplicate queue.
        && appealId == request.auth.uid + '_'
             + request.resource.data.subjectType + '_'
             + request.resource.data.subjectId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        // A decision is the administrator's to write, and only on an appeal that
        // already exists.
        && !('response' in request.resource.data)
        && !('reviewedBy' in request.resource.data)
        && !('reviewedAt' in request.resource.data)
        && validAppeal(request.resource.data)
        // You may only appeal your own rejection, and only a real one. Without
        // this, `appeals` is an unmoderated text collection writable against any
        // id by any account.
        && (
          (request.resource.data.subjectType == 'disposal'
            && ownsRejectedDisposal(request.auth.uid,
                 request.resource.data.subjectId))
          || (request.resource.data.subjectType == 'claim'
            && ownsRejectedClaim(request.auth.uid,
                 request.resource.data.subjectId))
        );

      allow update: if isAdmin()
        && uidNotModified()
        // One decision only. An administrator cannot revisit an answered appeal,
        // for the same reason two administrators cannot both approve a disposal.
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'response', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['upheld', 'declined']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        // Mandatory on either outcome. An appeal answered with a status and no
        // words is not an answer — the same rule a rejection reason follows.
        && validString(request.resource.data.response, 10, 1000)
        && validAppeal(request.resource.data);

      allow delete: if false;
    }

    // =========================================================================
    // EPR PRODUCER PORTAL
    // =========================================================================
    //
    // Read access is scoped by a stored membership document; write access is
    // absent. That asymmetry is sharper here than anywhere else in this file,
    // and deliberately: every figure a regulator will read is produced by the
    // trusted service from an approved mass and a screened count (§0). If a
    // client could write one, security rules could only police one of the two
    // code paths that produce it, and the evidentiary value of the whole system
    // would rest on the weaker one.
    //
    // The collections below are therefore denied to every client on write,
    // administrators included — the same sentence, and the same reasoning, that
    // already governs `wallets`, `orders` and `stats`.

    // -------------------------------------------------------------------------
    // organizations — the obligated entity
    // -------------------------------------------------------------------------
    //
    // Readable by its own active members and by an administrator. Nothing else
    // on the platform can see that a company is registered at all: a Champion
    // has no business knowing which brands are obligated, and a rival producer
    // certainly does not.
    //
    // Every write is a server write. Onboarding approval sets `sizeClass`,
    // which fixes which gazette targets apply; a company that could set its own
    // would choose the year it is measured against.

    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId) || isAdmin();
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // organizationMembers — who is in which company, and in what capacity
    // -------------------------------------------------------------------------
    //
    // The composite id `{orgId}_{uid}` is what makes SEC-1 a single document
    // read; see `orgMemberPath` above.
    //
    // Two read branches, and the first is not redundant. Reading *your own*
    // membership must work even when it is `invited` or `removed`, so the app
    // can say "your access to this workspace was removed" instead of showing an
    // empty screen with no explanation. The second branch is the members list,
    // and it requires an active membership of that same organisation.
    //
    // Writes are absent for everyone. An invitation is issued, redeemed against
    // a single-use token and revoked by the trusted service (SEC-8); a client
    // that could write here could add itself to any organisation on the
    // platform, which is the whole tenancy boundary in one document.

    match /organizationMembers/{memberId} {
      allow read: if isSignedIn()
        && (
          memberId == resource.data.orgId + '_' + request.auth.uid
          || isOrgMember(resource.data.orgId)
          || isAdmin()
        );
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // producerSkus — read by the organisation, written only by the service
    // -------------------------------------------------------------------------
    //
    // §5.1 calls this "the one collection with a real client write path", on the
    // test this file applies throughout: keep a write here when the governing
    // constraint is expressible where it is enforced, as it is for a seller's
    // product price.
    //
    // THAT TEST FAILS HERE, AND IT FAILS ON THE CONSTRAINT THAT MATTERS.
    //
    // EPR-9's governing constraint is that the declared component masses **sum
    // to** the declared unit mass. Rules have no fold, no reduce and no way to
    // iterate a variable-length list, so that sum cannot be written in this
    // language at all. A create rule here can check that `components` is a list
    // of between one and twelve things and nothing whatsoever about what is in
    // them — which means it would accept a 5 kg declared unit mass alongside a
    // single 0.1 g body, and the 5 kg would become the baseline for every
    // verification and every attributed kilogram.
    //
    // Two further things a client write cannot do, both required elsewhere in
    // the specification:
    //
    //   EPR-44 requires every change to a producer's record to land in
    //   `producerAuditLog`. Rules cannot append to it — correctly, since an
    //   entry a client could author is an entry an attacker could author — so a
    //   client-written SKU is a change with no audit entry.
    //
    //   EPR-12 requires an edit that changes what was weighed to invalidate the
    //   verification and close the standing revision. That is a multi-document
    //   transaction across `producerSkus` and `skuRevisions`, conditional on a
    //   comparison with the stored document. Rules can refuse a write; they
    //   cannot perform the other half of one.
    //
    // So the write goes where those checks can actually run, exactly as a wallet
    // balance does. `POST /epr/skus` on the trusted service validates the sum on
    // integers, writes the audit entry in the same transaction, and applies the
    // invalidation. Reads stay here, scoped to the owning organisation.
    //
    // Recorded as a deliberate divergence from §5.1 in INTEGRATION_NOTES_EPR.md
    // rather than left as an undocumented difference between spec and code.

    match /producerSkus/{skuId} {
      // Scoped to the owning organisation. A producer's catalogue is
      // commercially sensitive — a rival reading which SKUs a company has
      // registered learns its packaging portfolio.
      allow read: if isSignedIn()
        && (isOrgMember(resource.data.orgId) || isAdmin());

      // Every write, including an Admin's. Same sentence as `wallets`.
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // skuRevisions — append-only, and the reason last quarter stays true
    // -------------------------------------------------------------------------
    //
    // A report issued last quarter must remain reproducible after a producer
    // edits a gram weight this quarter (EPR-12). Without a stored history of
    // what the verified mass *was*, and when, that is impossible — the only
    // figure available would be the current one, and re-running the report
    // would silently produce a different answer.
    //
    // Readable by the organisation, because a producer is entitled to see the
    // basis of the numbers Chokro certifies on its behalf. Written by nobody
    // but the service: a revision a client could author is a mass a client
    // could set.

    match /skuRevisions/{revisionId} {
      allow read: if isSignedIn()
        && (isOrgMember(resource.data.orgId) || isAdmin());
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // skuMassAudits — the weighing that makes a declared mass a verified one
    // -------------------------------------------------------------------------
    //
    // Sample size, measured mean, standard deviation, the scale photograph and
    // the operator. This is what a Department of Environment inspector would
    // ask to see, and it is what separates "Chokro verified this mass" from a
    // claim that a weighing happened.
    //
    // The producer reads its own audits — being shown the evidence for a figure
    // you are certified against is not optional — and writes none of them.

    match /skuMassAudits/{auditId} {
      allow read: if isSignedIn()
        && (isOrgMember(resource.data.orgId) || isAdmin());
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // orgInvitations — invisible to every client, in both directions
    // -------------------------------------------------------------------------
    //
    // The only collection in this file denied even a read to the party it
    // concerns. An owner sees its organisation's outstanding invitations
    // through the trusted service, which returns the address, the role and the
    // status and never the token — because no token is stored. The document id
    // *is* the SHA-256 digest of the token, so a read of this collection would
    // disclose only digests, and a read granted anyway would be a read that
    // serves nobody and widens the surface.
    //
    // Redemption is a public endpoint on the service (SEC-8), not a client
    // write: it creates a Firebase Auth account, a `users` document and a
    // membership in one commit, which rules cannot express and must not be
    // asked to.

    match /orgInvitations/{invitationId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // producerAuditHeads — the chain pointer
    // -------------------------------------------------------------------------
    //
    // One document per organisation holding the latest sequence and digest, so
    // an appended entry can link to its predecessor in a single read. Not
    // evidence in itself — rewriting a head cannot forge a chain, only make the
    // next entry link to the wrong place, which `verifyChain` then reports —
    // but it is what makes a *truncated* log detectable, so no client touches
    // it either.

    match /producerAuditHeads/{orgId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // producerAuditLog — append-only, and append-only for administrators too
    // -------------------------------------------------------------------------
    //
    // SEC-12. Entries are hash-chained per organisation, so a removal is
    // detectable rather than merely forbidden — which matters because the Admin
    // SDK bypasses these rules by definition, and a control that only the
    // honest path respects is not a control.
    //
    // What the rules can enforce is that no client appends, amends or deletes
    // an entry, and that is written here as an unconditional denial rather than
    // as "create allowed, update denied". A client has no reason to append: the
    // entry that matters is the one the service writes in the same breath as
    // the action it records, and an entry a client could author would be an
    // entry an attacker could author.
    //
    // Reading is a different question. An organisation is entitled to see its
    // own history — that is most of what an audit trail is for — so its members
    // read it, and so does an administrator.

    match /producerAuditLog/{entryId} {
      allow read: if isSignedIn()
        && (isOrgMember(resource.data.orgId) || isAdmin());
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // stats — the dashboard's counters (F5.1)
    // -------------------------------------------------------------------------
    //
    // Incremented with FieldValue.increment() inside the same server transactions
    // that cause them (§6.3), rather than recounted by reading whole collections.
    //
    // Admin read only. These are platform aggregates — how many points exist, how
    // much has been sold — and there is no reason a buyer needs them. Writes are
    // denied to everyone, because a counter a client could touch would stop being
    // evidence of anything.

    match /stats/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Everything else is denied.
    // -------------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
